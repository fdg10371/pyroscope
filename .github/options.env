# Shared build and deploy configuration.
# Override any variable here; per-environment overrides go in options-dev.env / options-prod.env.
#
# Applications deployed by Argo CD (from the dss-applications-argocd-configs
# repository) only use the build options; the deploy options are read only by
# the legacy deploy.yml workflow.

# --- Build options ---
#
# IMAGE_PROJECT: Harbor project for the container image.
#   Defaults to c3s-applications if not set here.
IMAGE_PROJECT=c3s-applications
#
# IMAGE_REPOSITORY: Image repository name within the project.
#   Defaults to the GitHub repository name if not set here.
IMAGE_REPOSITORY=pyroscope

# --- Deploy options (legacy deploy.yml only; ignored by Argo CD) ---
#
# RELEASE_NAME: Helm release name.
#   Defaults to the GitHub repository name if not set here.
# RELEASE_NAME=your-app-name
#
# NAMESPACE: Target Kubernetes namespace.
#   Defaults to cads-apps-<environment> if not set here.
# NAMESPACE=cads-apps-dev

# HELM_CHART and HELM_CHART_VERSION: Helm chart reference and version.
# Defaults to the single-pod-application chart in the C3S Applications registry, version 0.5.3, if not set here.
# HELM_CHART=oci://eccr.ecmwf.int/c3s-applications/single-pod-application
# HELM_CHART_VERSION=0.5.3

# Path to the kubeconfig file on the self-hosted runner, defaults to /home/cds/.kubeconfig if not set here.
# KUBECONFIG=/home/cds/.kubeconfig

# Comma-separated list of Helm values files (merged left to right).
# Defaults to: deployment/values.yaml,deployment/values-<environment>.yaml
# VALUES_FILE=deployment/values.yaml,deployment/values-dev.yaml
#
# Additional arguments appended to 'helm upgrade --install'.
# HELM_EXTRA_ARGS=--timeout 5m0s
